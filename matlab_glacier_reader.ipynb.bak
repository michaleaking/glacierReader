    "glacierData = {}\n",
    "for glacier, box in zip([name], [box]):\n",
    "    glacierData[glacier] = {}\n",
    "# Search catalog for all products\n",
    "    prodFilter = {'TSX': box} #, 'Opt': box}\n",
    "    for product in products:\n",
    "        myUrls = grimp.cmrUrls(mode='subsetter')  # mode image restricts search to the image products myUrls = grimp.cmrUrls(mode='nisar')\n",
    "        myUrls.initialSearch(firstDate='1984-01-01', lastDate='2025-05-01', product=nsidcNames[product], productFilter=prodFilter[product]) \n",
    "        glacierData[glacier][f'{product}Cogs'] =  myUrls.getCogs(replace=prodReplace[product], removeTiff=True)\n",
    "        print(f'{glacier} {product} {len(glacierData[glacier][f\"{product}Cogs\"])}')"
   ]
  },
