      "\u001b[36mFile \u001b[39m\u001b[32m~/anaconda3/envs/greenlandMapping_new/lib/python3.12/site-packages/nisardev/nisarBase2D.py:360\u001b[39m, in \u001b[36mnisarBase2D._lazyOpenProduct\u001b[39m\u001b[34m(self, fileNameBase, bbox, masked, url, time, xrName, skip, overviewLevel, suffix, **kw)\u001b[39m\n\u001b[32m    357\u001b[39m         bandTiff = fileNameBase\n\u001b[32m    358\u001b[39m     bandTiff = \\\n\u001b[32m    359\u001b[39m         \u001b[33mf\u001b[39m\u001b[33m\"\u001b[39m\u001b[38;5;132;01m{\u001b[39;00mbandTiff.replace(\u001b[33m'\u001b[39m\u001b[33m*\u001b[39m\u001b[33m'\u001b[39m,\u001b[38;5;250m \u001b[39m\u001b[38;5;28mself\u001b[39m.variables[\u001b[32m0\u001b[39m])\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m.tif\u001b[39m\u001b[38;5;132;01m{\u001b[39;00msuffix\u001b[38;5;132;01m}\u001b[39;00m\u001b[33m\"\u001b[39m\n\u001b[32m--> \u001b[39m\u001b[32m360\u001b[39m     \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_createTemplate\u001b[49m\u001b[43m(\u001b[49m\u001b[43mbandTiff\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    361\u001b[39m \u001b[43m                         \u001b[49m\u001b[43moverviewLevel\u001b[49m\u001b[43m=\u001b[49m\u001b[43moverviewLevel\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    362\u001b[39m \u001b[43m                         \u001b[49m\u001b[43mbbox\u001b[49m\u001b[43m=\u001b[49m\u001b[43mbbox\u001b[49m\u001b[43m)\u001b[49m\n\u001b[32m    363\u001b[39m \u001b[38;5;66;03m# loop to process bands as individual xrs\u001b[39;00m\n\u001b[32m    364\u001b[39m das = []\n",
