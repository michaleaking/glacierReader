      "\u001b[36mFile \u001b[39m\u001b[32m~/anaconda3/envs/greenlandMapping_new/lib/python3.12/site-packages/nisardev/nisarBase2D.py:152\u001b[39m, in \u001b[36mnisarBase2D.readXR\u001b[39m\u001b[34m(self, fileNameBase, bbox, url, masked, useStack, time, time1, time2, xrName, skip, overviewLevel, suffix, chunkSize)\u001b[39m\n\u001b[32m    148\u001b[39m \u001b[38;5;66;03m# Do a lazy open on the tiffs\u001b[39;00m\n\u001b[32m    149\u001b[39m \u001b[38;5;66;03m# For now useStack turned off since it tries to read the full res\u001b[39;00m\n\u001b[32m    150\u001b[39m \u001b[38;5;66;03m# data and donwsample instead of the pyramid\u001b[39;00m\n\u001b[32m    151\u001b[39m \u001b[38;5;28;01mif\u001b[39;00m useStack:\n\u001b[32m--> \u001b[39m\u001b[32m152\u001b[39m     myXR = \u001b[38;5;28;43mself\u001b[39;49m\u001b[43m.\u001b[49m\u001b[43m_lazyOpenProduct\u001b[49m\u001b[43m(\u001b[49m\u001b[43mfileNameBase\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    153\u001b[39m \u001b[43m                                 \u001b[49m\u001b[43mbbox\u001b[49m\u001b[43m=\u001b[49m\u001b[43mbbox\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    154\u001b[39m \u001b[43m                                 \u001b[49m\u001b[43murl\u001b[49m\u001b[43m=\u001b[49m\u001b[43murl\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    155\u001b[39m \u001b[43m                                 \u001b[49m\u001b[43mmasked\u001b[49m\u001b[43m=\u001b[49m\u001b[43mmasked\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    156\u001b[39m \u001b[43m                                 \u001b[49m\u001b[43mtime\u001b[49m\u001b[43m=\u001b[49m\u001b[43mtime\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43mxrName\u001b[49m\u001b[43m=\u001b[49m\u001b[43mxrName\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    157\u001b[39m \u001b[43m                                 \u001b[49m\u001b[43mskip\u001b[49m\u001b[43m=\u001b[49m\u001b[43mskip\u001b[49m\u001b[43m,\u001b[49m\n\u001b[32m    158\u001b[39m \u001b[43m                               